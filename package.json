{
  "name": "onway",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write src docs *.json *.ts *.js *.html *.md",
    "format:check": "prettier --check src docs *.json *.ts *.js *.html *.md",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/core": "^8.5.1",
    "dexie": "^4.4.5",
    "lucide-react": "^1.43.0",
    "maplibre-gl": "^6.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
